<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinThrustBLE — ControlActivity layout
  Sunlight theme: pure white text on true-black backgrounds, no dark grey.
  All interactive text ≥ 14sp. Status bar text ≥ 13sp bold.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:fillViewport="true">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="8dp">

    <!-- ══ TOP BAR ══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#001530"
        android:padding="8dp" android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

      <!-- Port -->
      <LinearLayout android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvPortLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="PORT"
            android:textColor="#00FF66" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPortStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Connecting..."
            android:textColor="#FF4444" android:textSize="12sp"/>
        <TextView android:id="@+id/tvPortBatt" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#FFFFFF" android:textSize="12sp"/>
      </LinearLayout>

      <!-- Mode toggle -->
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:orientation="vertical" android:gravity="center"
          android:paddingHorizontal="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="BLDC" android:textColor="#AAAAAA" android:textSize="12sp"
              android:paddingEnd="3dp"/>
          <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMode"
              android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/tvModeLabel" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="ESC"
              android:textColor="#FFFFFF" android:textSize="12sp" android:paddingStart="3dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvFrontStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#00FFFF" android:textSize="11sp" android:gravity="center"/>
      </LinearLayout>

      <!-- Stbd -->
      <LinearLayout android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:gravity="end">
        <TextView android:id="@+id/tvStbdLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="STBD"
            android:textColor="#4499FF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvStbdStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Connecting..."
            android:textColor="#FF4444" android:textSize="12sp"/>
        <TextView android:id="@+id/tvStbdBatt" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#FFFFFF" android:textSize="12sp"/>
      </LinearLayout>
    </LinearLayout>

    <!-- ══ GPS ROW ══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#000811"
        android:gravity="center_vertical" android:paddingVertical="6dp"
        android:layout_marginBottom="6dp">

      <!-- Left GPS -->
      <LinearLayout android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:paddingStart="8dp">
        <TextView android:id="@+id/tvGpsFix" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="No Fix"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvGpsHeading" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="&#8212;"
            android:textColor="#FFFF00" android:textSize="13sp" android:textStyle="bold"/>
      </LinearLayout>

      <!-- Big speed centre -->
      <LinearLayout android:layout_width="0dp" android:layout_weight="2"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
          <TextView android:id="@+id/tvSpeedUnit" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="km/h"
              android:textSize="16sp" android:textColor="#00CCFF"
              android:textStyle="bold" android:paddingEnd="6dp"/>
          <Button android:id="@+id/btnSpeedUnit" android:layout_width="wrap_content"
              android:layout_height="36dp" android:minWidth="60dp"
              android:text="km/h" android:textSize="12sp" android:textStyle="bold"
              android:backgroundTint="#003355"/>
        </LinearLayout>
        <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0.0"
            android:textSize="80sp" android:textStyle="bold" android:textColor="#00EEFF"
            android:fontFamily="monospace" android:gravity="center"
            android:includeFontPadding="false"/>
      </LinearLayout>

      <!-- Right GPS + Log switch -->
      <LinearLayout android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:gravity="end" android:paddingEnd="8dp">
        <TextView android:id="@+id/tvGpsAlt" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="&#8212;"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvGpsCoords" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="&#8212;"
            android:textColor="#CCCCCC" android:textSize="11sp"/>
        <!-- Log toggle -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="4dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="LOG" android:textColor="#FFFF00" android:textSize="13sp"
              android:textStyle="bold" android:paddingEnd="4dp"/>
          <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLog"
              android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/tvLogStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Log: off"
            android:textColor="#AAAAAA" android:textSize="11sp" android:gravity="end"/>
      </LinearLayout>
    </LinearLayout>

    <!-- ══ SINGLE-MODE PANEL ══ -->
    <LinearLayout android:id="@+id/layoutSingle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:visibility="gone">

      <TextView android:id="@+id/tvAssignBanner" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Assign this module"
          android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
          android:padding="10dp" android:layout_marginBottom="6dp"/>
      <TextView android:id="@+id/tvSingleName" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="BLE Module"
          android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
          android:gravity="center" android:paddingBottom="6dp"/>

      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnAssignPort" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="PORT&#10;M1+M2 Left" android:textSize="13sp"
            android:textStyle="bold" android:backgroundTint="#004400"
            android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnAssignStbd" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="STBD&#10;M3+M4 Right" android:textSize="13sp"
            android:textStyle="bold" android:backgroundTint="#000044"
            android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnAssignFront" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="FRONT&#10;M5+M6" android:textSize="13sp"
            android:textStyle="bold" android:backgroundTint="#004444"
            android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnAssignRemote" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="REMOTE" android:textSize="13sp"
            android:textStyle="bold" android:backgroundTint="#444400"/>
      </LinearLayout>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="TEST THROTTLE — spin to verify" android:textColor="#FFFF00"
          android:textSize="13sp" android:textStyle="bold" android:paddingBottom="4dp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical"
          android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnSingleDown" android:layout_width="64dp"
            android:layout_height="64dp" android:text="&#9660;" android:textSize="26sp"
            android:textStyle="bold" android:backgroundTint="#443300" android:padding="0dp"/>
        <SeekBar android:id="@+id/seekSingle" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:progressTint="#FFCC00" android:thumbTint="#FFCC00"
            android:max="100" android:layout_marginHorizontal="8dp"/>
        <Button android:id="@+id/btnSingleUp" android:layout_width="64dp"
            android:layout_height="64dp" android:text="&#9650;" android:textSize="26sp"
            android:textStyle="bold" android:backgroundTint="#443300" android:padding="0dp"/>
        <TextView android:id="@+id/tvSinglePct" android:layout_width="72dp"
            android:layout_height="wrap_content" android:text="0%" android:textColor="#FFCC00"
            android:textSize="16sp" android:textStyle="bold" android:gravity="end"
            android:paddingStart="6dp"/>
      </LinearLayout>
      <Button android:id="@+id/btnSingleStop" android:layout_width="match_parent"
          android:layout_height="60dp" android:text="STOP" android:textStyle="bold"
          android:textSize="20sp" android:backgroundTint="#CC0000" android:enabled="false"/>
    </LinearLayout>

    <!-- ══ DUAL-MODE PANEL ══ -->
    <LinearLayout android:id="@+id/layoutDual" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:visibility="gone">

      <!-- 4+2 motor status bar -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:background="#000811"
          android:padding="6dp" android:layout_marginBottom="6dp">

        <!-- M1 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="2dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M1" android:textColor="#00FF66" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM1" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#00FF66" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM1Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#00FF66" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM1Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AAFFAA" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

        <!-- M2 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="4dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M2" android:textColor="#00FF66" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM2" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#00FF66" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM2Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#00FF66" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM2Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AAFFAA" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

        <!-- M3 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="4dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M3" android:textColor="#4499FF" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM3" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#4499FF" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM3Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#4499FF" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM3Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AACCFF" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

        <!-- M4 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="2dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M4" android:textColor="#4499FF" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM4" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#4499FF" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM4Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#4499FF" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM4Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AACCFF" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>

      <!-- M5+M6 (front) status row — separate so it can hide if no front module -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:background="#000811"
          android:padding="6dp" android:layout_marginBottom="6dp">

        <!-- M5 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="4dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M5 (Front)" android:textColor="#00FFFF" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM5" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#00FFFF" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM5Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#00FFFF" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM5Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AAFFFF" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

        <!-- M6 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="4dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="M6 (Front)" android:textColor="#00FFFF" android:textSize="13sp"
              android:textStyle="bold" android:gravity="center"/>
          <ProgressBar android:id="@+id/pbM6" style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent" android:layout_height="12dp"
              android:progressTint="#00FFFF" android:max="100"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tvM6Pct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#00FFFF" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="|" android:textColor="#555555" android:textSize="14sp"
                android:paddingHorizontal="2dp"/>
            <TextView android:id="@+id/tvM6Duty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="500"
                android:textColor="#AAFFFF" android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/tvFrontCurrent" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFFF00" android:textSize="14sp"
            android:textStyle="bold" android:gravity="center"/>
      </LinearLayout>

      <!-- Sync selector -->
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnSyncAll" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="60dp"
            android:text="All Sync" android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="#0055CC" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnSyncSide" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="60dp"
            android:text="Side Sync" android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="#333333" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnSyncNone" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="60dp"
            android:text="Indep." android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="#333333"/>
      </LinearLayout>

      <!-- ── SYNC_ALL panel ── -->
      <LinearLayout android:id="@+id/layoutSyncAll" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:background="#001020" android:padding="10dp"
          android:layout_marginBottom="6dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MASTER THROTTLE" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" android:paddingBottom="6dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingBottom="10dp">
          <Button android:id="@+id/btnMasterDown" android:layout_width="68dp"
              android:layout_height="68dp" android:text="&#9660;" android:textSize="26sp"
              android:textStyle="bold" android:backgroundTint="#003355" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekMaster" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="wrap_content"
              android:progressTint="#00EEFF" android:thumbTint="#00EEFF"
              android:max="100" android:layout_marginHorizontal="8dp"/>
          <Button android:id="@+id/btnMasterUp" android:layout_width="68dp"
              android:layout_height="68dp" android:text="&#9650;" android:textSize="26sp"
              android:textStyle="bold" android:backgroundTint="#003355" android:padding="0dp"/>
          <TextView android:id="@+id/tvMasterPct" android:layout_width="56dp"
              android:layout_height="wrap_content" android:text="0%" android:textColor="#00EEFF"
              android:textSize="16sp" android:textStyle="bold" android:gravity="end"
              android:paddingStart="4dp"/>
        </LinearLayout>

        <!-- Side trim -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SIDE TRIM" android:textColor="#FFFF00"
            android:textSize="13sp" android:textStyle="bold" android:paddingBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="L" android:textColor="#00FF66" android:textSize="15sp"
              android:textStyle="bold" android:paddingEnd="4dp"/>
          <Button android:id="@+id/btnPortSideTrimDown" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <TextView android:id="@+id/tvPortSideTrimVal" android:layout_width="44dp"
              android:layout_height="wrap_content" android:text="0"
              android:textColor="#00FF66" android:textSize="15sp"
              android:textStyle="bold" android:gravity="center"/>
          <Button android:id="@+id/btnPortSideTrimUp" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>

          <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>

          <Button android:id="@+id/btnResetTrims" android:layout_width="52dp"
              android:layout_height="56dp" android:text="RST" android:textSize="13sp"
              android:textStyle="bold" android:backgroundTint="#553300"/>

          <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>

          <Button android:id="@+id/btnStbdSideTrimDown" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:id="@+id/tvStbdSideTrimVal" android:layout_width="44dp"
              android:layout_height="wrap_content" android:text="0"
              android:textColor="#4499FF" android:textSize="15sp"
              android:textStyle="bold" android:gravity="center"/>
          <Button android:id="@+id/btnStbdSideTrimUp" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="R" android:textColor="#4499FF" android:textSize="15sp"
              android:textStyle="bold" android:paddingStart="4dp"/>
        </LinearLayout>

        <!-- Port/Stbd pct display -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
          <TextView android:id="@+id/tvPortPct" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="wrap_content"
              android:text="L 0%" android:textColor="#00FF66"
              android:textSize="16sp" android:textStyle="bold" android:gravity="center"/>
          <TextView android:id="@+id/tvStbdPct" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="wrap_content"
              android:text="R 0%" android:textColor="#4499FF"
              android:textSize="16sp" android:textStyle="bold" android:gravity="center"/>
        </LinearLayout>
      </LinearLayout>

      <!-- ── SYNC_SIDE panel ── -->
      <LinearLayout android:id="@+id/layoutSyncSide" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="horizontal"
          android:background="#001020" android:padding="10dp"
          android:layout_marginBottom="6dp" android:visibility="gone">

        <!-- Port side -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="8dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="PORT  M1+M2" android:textColor="#00FF66"
              android:textSize="14sp" android:textStyle="bold" android:paddingBottom="4dp"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnPortSideDown" android:layout_width="56dp"
                android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
                android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
            <SeekBar android:id="@+id/seekPort" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:progressTint="#00FF66" android:thumbTint="#00FF66"
                android:layout_marginHorizontal="4dp"/>
            <Button android:id="@+id/btnPortSideUp" android:layout_width="56dp"
                android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
                android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          </LinearLayout>
          <TextView android:id="@+id/tvPortSidePct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#00FF66" android:textSize="16sp"
              android:textStyle="bold" android:gravity="center" android:paddingTop="4dp"/>
        </LinearLayout>

        <!-- Stbd side -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="8dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="STBD  M3+M4" android:textColor="#4499FF"
              android:textSize="14sp" android:textStyle="bold"
              android:gravity="end" android:paddingBottom="4dp"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
              android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnStbdSideDown" android:layout_width="56dp"
                android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
                android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
            <SeekBar android:id="@+id/seekStbd" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:progressTint="#4499FF" android:thumbTint="#4499FF"
                android:layout_marginHorizontal="4dp"/>
            <Button android:id="@+id/btnStbdSideUp" android:layout_width="56dp"
                android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
                android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          </LinearLayout>
          <TextView android:id="@+id/tvStbdSidePct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#4499FF" android:textSize="16sp"
              android:textStyle="bold" android:gravity="center" android:paddingTop="4dp"/>
        </LinearLayout>
      </LinearLayout>

      <!-- ── SYNC_NONE panel: 6 columns ── -->
      <LinearLayout android:id="@+id/layoutSyncNone" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="horizontal"
          android:background="#001020" android:padding="6dp"
          android:layout_marginBottom="6dp" android:visibility="gone">

        <!-- M1 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="2dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M1" android:textColor="#00FF66" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM1Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM1" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#00FF66"
              android:thumbTint="#00FF66"/>
          <Button android:id="@+id/btnM1Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <TextView android:id="@+id/tvM1OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#00FF66" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
        <!-- M2 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingEnd="3dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M2" android:textColor="#00FF66" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM2Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM2" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#00FF66"
              android:thumbTint="#00FF66"/>
          <Button android:id="@+id/btnM2Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <TextView android:id="@+id/tvM2OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#00FF66" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
        <!-- M3 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="3dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M3" android:textColor="#4499FF" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM3Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM3" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#4499FF"
              android:thumbTint="#4499FF"/>
          <Button android:id="@+id/btnM3Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:id="@+id/tvM3OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#4499FF" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
        <!-- M4 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="2dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M4" android:textColor="#4499FF" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM4Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM4" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#4499FF"
              android:thumbTint="#4499FF"/>
          <Button android:id="@+id/btnM4Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:id="@+id/tvM4OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#4499FF" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
        <!-- M5 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="3dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M5" android:textColor="#00FFFF" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM5Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM5" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#00FFFF"
              android:thumbTint="#00FFFF"/>
          <Button android:id="@+id/btnM5Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
          <TextView android:id="@+id/tvM5OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#00FFFF" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
        <!-- M6 -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="2dp" android:gravity="center_horizontal">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="M6" android:textColor="#00FFFF" android:textSize="13sp" android:textStyle="bold"/>
          <Button android:id="@+id/btnM6Up" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
          <SeekBar android:id="@+id/seekM6" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:progressTint="#00FFFF"
              android:thumbTint="#00FFFF"/>
          <Button android:id="@+id/btnM6Down" android:layout_width="match_parent"
              android:layout_height="52dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
          <TextView android:id="@+id/tvM6OnlyPct" android:layout_width="match_parent"
              android:layout_height="wrap_content" android:text="0%"
              android:textColor="#00FFFF" android:textSize="12sp" android:textStyle="bold"
              android:gravity="center"/>
        </LinearLayout>
      </LinearLayout>

      <!-- ── F/R trim + front trim ── -->
      <LinearLayout android:id="@+id/layoutFRTrim" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:background="#001020" android:padding="8dp"
          android:layout_marginBottom="6dp">

        <!-- F/R trim row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingBottom="6dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="F/R" android:textColor="#FFFF00" android:textSize="13sp"
              android:textStyle="bold" android:paddingEnd="6dp"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="L" android:textColor="#00FF66" android:textSize="15sp"
              android:textStyle="bold" android:paddingEnd="4dp"/>
          <Button android:id="@+id/btnPortFRTrimDown" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>
          <TextView android:id="@+id/tvPortFRTrimVal" android:layout_width="44dp"
              android:layout_height="wrap_content" android:text="0"
              android:textColor="#00FF66" android:textSize="15sp"
              android:textStyle="bold" android:gravity="center"/>
          <Button android:id="@+id/btnPortFRTrimUp" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004400" android:padding="0dp"/>

          <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>

          <Button android:id="@+id/btnStbdFRTrimDown" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:id="@+id/tvStbdFRTrimVal" android:layout_width="44dp"
              android:layout_height="wrap_content" android:text="0"
              android:textColor="#4499FF" android:textSize="15sp"
              android:textStyle="bold" android:gravity="center"/>
          <Button android:id="@+id/btnStbdFRTrimUp" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#000044" android:padding="0dp"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="R" android:textColor="#4499FF" android:textSize="15sp"
              android:textStyle="bold" android:paddingStart="4dp"/>
        </LinearLayout>

        <!-- Front trim row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="FRONT" android:textColor="#00FFFF" android:textSize="13sp"
              android:textStyle="bold" android:paddingEnd="6dp"/>
          <Button android:id="@+id/btnFrontTrimDown" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9660;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
          <TextView android:id="@+id/tvFrontTrimVal" android:layout_width="44dp"
              android:layout_height="wrap_content" android:text="0"
              android:textColor="#00FFFF" android:textSize="15sp"
              android:textStyle="bold" android:gravity="center"/>
          <Button android:id="@+id/btnFrontTrimUp" android:layout_width="56dp"
              android:layout_height="56dp" android:text="&#9650;" android:textSize="20sp"
              android:textStyle="bold" android:backgroundTint="#004444" android:padding="0dp"/>
        </LinearLayout>
      </LinearLayout>

      <!-- STOP -->
      <Button android:id="@+id/btnStop" android:layout_width="match_parent"
          android:layout_height="68dp" android:text="STOP ALL MOTORS"
          android:textSize="20sp" android:textStyle="bold"
          android:backgroundTint="#DD0000" android:enabled="false"/>

    </LinearLayout><!-- end layoutDual -->
  </LinearLayout>
</ScrollView>